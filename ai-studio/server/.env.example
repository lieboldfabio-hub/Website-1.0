# ============================================================================
# S & F KI-Studio – Server-Konfiguration
# ----------------------------------------------------------------------------
# Kopieren nach ".env" (liegt im .gitignore, wird NIE eingecheckt) und mit den
# echten Werten fuellen. Ohne .env startet der Server trotzdem – dann sind
# nur der Mock-Provider und die Endpunkte ohne Bild-/Videogenerierung nutzbar.
# ============================================================================

# --- Zugriffsschutz -----------------------------------------------------
# Frei waehlbares, langes Zufalls-Token. Muss im Frontend (ki-studio.html)
# beim Login eingetragen werden. Ohne dieses Token lehnt der Server jede
# erzeugende oder aendernde Anfrage ab (Bilder/Videos kosten echtes Geld).
ADMIN_TOKEN=

# Erlaubte Herkunft fuer Browser-Anfragen (CORS). Mehrere Domains durch
# Komma trennen. Beispiel: https://www.sf-webseiten.de,http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

PORT=8787

# --- Kostenschutz ---------------------------------------------------------
# Harte Obergrenze an Generierungen (Bild + Video zusammen) pro Kalendertag,
# unabhaengig vom Provider. Schuetzt vor einer aus dem Ruder laufenden
# Rechnung, falls das Token einmal in falsche Haende geraet.
MAX_DAILY_GENERATIONS=40

# --- Bild-Provider ----------------------------------------------------------

# OpenAI (Bilder) – https://platform.openai.com/api-keys
# Modell fuer Bildgenerierung, Standard: gpt-image-1
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Google Gemini (Bilder) – https://aistudio.google.com/apikey
# Modell mit nativer Bildausgabe, Standard: gemini-2.5-flash-image
GOOGLE_API_KEY=
GOOGLE_IMAGE_MODEL=gemini-2.5-flash-image

# --- Video-Provider ---------------------------------------------------------

# Runway ML (Video) – https://dev.runwayml.com/
RUNWAY_API_KEY=
RUNWAY_API_VERSION=2024-11-06
RUNWAY_MODEL=gen4_turbo

# Luma AI Dream Machine (Video) – https://lumalabs.ai/dream-machine/api/keys
LUMA_API_KEY=

# --- Test-/Entwicklungsmodus -------------------------------------------
# Schaltet einen kostenlosen Mock-Provider frei (Platzhaltergrafik statt
# echter KI-Bilder, keine externe Anfrage). Nuetzlich, um die komplette
# Oberflaeche ohne Kosten und ohne API-Schluessel zu testen. NIE in
# Produktion aktiviert lassen.
AI_STUDIO_ENABLE_MOCK=true

# --- Medienablage --------------------------------------------------------
# Absoluter Pfad zur Wurzel dieses Repos. Wenn gesetzt, kann "Fuer Website
# uebernehmen" das Bild direkt in beispiele/<projekt>/assets/img/ ablegen.
# Leer lassen, wenn der Server nicht auf einer Kopie des Repos laeuft (z. B.
# gehostet auf Render/Railway) – dann gibt es die Datei stattdessen zum
# Herunterladen mit dem passenden Zielpfad als Hinweis.
AI_STUDIO_REPO_ROOT=
